rules_version = '2';

// users/{uid}            — each person's own profile, settings and personal book
// books/{bookId}         — a shared family book; only its members can read or write it
// invites/{code}         — maps an invite code to a book so someone with the code can join
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function validEntry(extraKeys) {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'd', 'a', 'c', 'n', 'pm', 'rec'].concat(extraKeys))
        && d.type in ['exp', 'inc']
        && d.d is string && d.d.size() == 10
        && d.a is number && d.a > 0 && d.a < 1000000000
        && d.c is string && d.c.size() <= 60
        && d.n is string && d.n.size() <= 120;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['profile', 'categories', 'recurring', 'budget', 'settings', 'createdAt']);

      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEntry([]);
      }
    }

    match /books/{bookId} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function isBookOwner() { return signedIn() && request.auth.uid == resource.data.owner; }
      function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
      function bookKeys() {
        return request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'memberNames', 'inviteCode', 'joinCode',
          'categories', 'recurring', 'budget', 'createdAt']);
      }

      // members list their books with where('members', 'array-contains', uid)
      allow read: if isMember();

      allow create: if signedIn() && bookKeys()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if bookKeys() && request.resource.data.owner == resource.data.owner && (
        // any member: shared settings and their own display name
        (isMember() && onlyChanged(['name', 'categories', 'recurring', 'budget', 'memberNames']))
        // the owner: manage members and the invite code (and stays a member)
        || (isBookOwner() && onlyChanged(['members', 'memberNames', 'inviteCode'])
            && request.auth.uid in request.resource.data.members)
        // a member who is not the owner leaves
        || (isMember() && !isBookOwner() && onlyChanged(['members', 'memberNames'])
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
        // someone with the current invite code joins (adds only themselves, max 10 people)
        || (signedIn() && !isMember() && onlyChanged(['members', 'memberNames', 'joinCode'])
            && request.resource.data.joinCode == resource.data.inviteCode
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && resource.data.members.size() < 10)
      );

      allow delete: if isBookOwner();

      match /entries/{entryId} {
        function bookMember() {
          return signedIn() && request.auth.uid in get(/databases/$(database)/documents/books/$(bookId)).data.members;
        }
        allow read, delete: if bookMember();
        allow create, update: if bookMember() && validEntry(['by']) && request.resource.data.by is string;
      }
    }

    match /invites/{code} {
      function ownsBook(id) { return get(/databases/$(database)/documents/books/$(id)).data.owner == request.auth.uid; }
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['bookId', 'name', 'by'])
        && ownsBook(request.resource.data.bookId);
      allow delete: if signedIn() && ownsBook(resource.data.bookId);
    }
  }
}
